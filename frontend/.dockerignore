# Version control
.git/
.gitignore
.gitattributes

# Docker configuration files
.dockerignore
Dockerfile*

# IDE and Editor files
.vscode/
.idea/
*.suo
*.user
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Temporary files
*.tmp
*.temp
