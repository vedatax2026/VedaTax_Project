# ==============================================================================
# Root .dockerignore: Prevents cross-service leaks and excludes unnecessary files
# ==============================================================================

# Node / Frontend build & dependencies
**/node_modules/
**/.pnp/
**/.pnp.js
**/dist/
**/build/

# .NET / Backend build artifacts
**/bin/
**/obj/

# User uploaded documents (never bake into images)
**/App_Data/uploads/*
!**/App_Data/uploads/.gitkeep

# Environment and sensitive configuration files
**/.env
**/.env.local
**/.env.*.local
**/*.env
**/appsettings.*.local.json

# Version control metadata
**/.git/
**/.gitignore
**/.gitattributes

# IDE, editor and OS metadata
**/.vs/
**/.vscode/
**/.idea/
**/*.user
**/*.userosscache
**/*.suo
**/*.userprefs
**/.DS_Store
**/Thumbs.db

# Package manager and runtime logs
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*

# Temporary files and scratch notes
**/*.tmp
**/*.temp
InitialDraft-*.txt
*.jpeg
*.jpg
*.png
