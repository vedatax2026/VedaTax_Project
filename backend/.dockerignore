# Build outputs and compilation artifacts
**/bin/
**/obj/

# Stored uploads and user files (do not bake into image)
**/App_Data/uploads/*
!**/App_Data/uploads/.gitkeep

# IDE, editor and visual studio files
**/.vs/
**/.vscode/
**/.idea/
**/*.user
**/*.userosscache
**/*.suo
**/*.userprefs

# Version control
**/.git/
**/.gitignore
**/.gitattributes

# Docker configuration files
**/.dockerignore
**/Dockerfile*

# Local environment and secret overrides
**/*.env
**/*.env.*
**/appsettings.*.local.json

# Operating System files
**/.DS_Store
**/Thumbs.db

# Logs
**/*.log
