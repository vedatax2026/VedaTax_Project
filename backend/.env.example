# ASP.NET Core Environment (Production or Development)
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# PostgreSQL Database Connection String
# When using Docker Compose, hostname is the service name 'db' or 'postgres'
ConnectionStrings__Default=Host=db;Port=5432;Database=vedatax;Username=postgres;Password=postgres_secure_password

# JWT Authentication (Key MUST be at least 32 characters long)
Jwt__Key=super-secret-jwt-key-replace-with-at-least-32-chars-long-secret
Jwt__Issuer=VedaTax
Jwt__Audience=VedaTax.Web
Jwt__ExpiryMinutes=120

# CORS Allowed Origins (Set to your frontend domain in production)
Cors__Origins__0=http://localhost
Cors__Origins__1=http://localhost:80
Cors__Origins__2=https://vedatax.com

# File Storage Configuration (relative to app content root, or absolute path)
Storage__UploadsPath=App_Data/uploads
Storage__MaxFileBytes=15728640

# Optional Initial Staff Account (used when ASPNETCORE_ENVIRONMENT=Development)
SeedAdmin__Email=admin@vedatax.test
SeedAdmin__Password=VedaStaff#2026
