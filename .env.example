# ==============================================================================
# VedaTax Root Docker Compose Environment Configuration
# Copy this file to .env before running `docker compose up`
# ==============================================================================

# Database Configuration
POSTGRES_DB=vedatax
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_PORT=5432

# Backend API Configuration
API_PORT=5080
ASPNETCORE_ENVIRONMENT=Development
# In production, replace with a strong 32+ character random secret
JWT_KEY=dev-only-vedatax-signing-key-change-me-0123456789
SEED_ADMIN_EMAIL=admin@vedatax.test
SEED_ADMIN_PASSWORD=VedaStaff#2026

# Website Frontend Configuration
WEB_PORT=80
